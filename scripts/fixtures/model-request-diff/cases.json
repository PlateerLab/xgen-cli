{
  "formatVersion": 1,
  "cases": [
    {
      "name": "trust-read-with-instructions",
      "description": "Trusted interactive session: environment note, project AGENTS.md, one read, then completion.",
      "args": [
        "--trust"
      ],
      "files": {
        "README.md": "fixture readme\n",
        "AGENTS.md": "Run tests with sh scripts/test.sh.\n"
      },
      "stdin": "Read README.md and report it.\n/exit\n",
      "replies": [
        {
          "plan": [
            "read",
            "xgeny.fs/read-text",
            {
              "path": "README.md"
            }
          ]
        },
        {
          "completion": "README read."
        }
      ]
    },
    {
      "name": "approved-write-and-command",
      "description": "Untrusted interactive session with session permissions: write, failed command, completion.",
      "args": [],
      "files": {
        "README.md": "fixture readme\n"
      },
      "stdin": "/permissions model allow\n/permissions read allow\n/permissions write allow\n/permissions execute allow\nSave notes.txt, run git with a bad option, and report.\n/exit\n",
      "replies": [
        {
          "plan": [
            "save",
            "xgeny.fs/write-atomic",
            {
              "path": "notes.txt",
              "content": "notes\n",
              "expectedDigest": null
            }
          ]
        },
        {
          "plan": [
            "bad_git",
            "xgeny.process/execute",
            {
              "executable": "git",
              "args": [
                "--definitely-invalid-option"
              ],
              "cwd": ".",
              "env": {},
              "timeoutMs": 30000,
              "maxOutputBytes": 32768
            }
          ]
        },
        {
          "completion": "Saved notes.txt; the command failed."
        }
      ]
    },
    {
      "name": "conversation-two-turns",
      "description": "Conversation-only answers; the second request carries the session context.",
      "args": [],
      "files": {},
      "stdin": "Explain a queue.\ny\nWhat topic did I ask about?\ny\n/exit\n",
      "replies": [
        {
          "response": "A queue is first-in first-out."
        },
        {
          "response": "You asked about a queue."
        }
      ]
    },
    {
      "name": "headless-run-read",
      "description": "Headless xgen run: legacy contract without session context or instructions.",
      "args": [
        "run",
        "Read README.md and summarize it.",
        "--allow-dir",
        ".",
        "--allow-remote-model-egress",
        "--allow-read"
      ],
      "files": {
        "README.md": "fixture readme\n",
        "AGENTS.md": "Not read by headless runs.\n"
      },
      "stdin": "",
      "replies": [
        {
          "plan": [
            "read",
            "xgeny.fs/read-text",
            {
              "path": "README.md"
            }
          ]
        },
        {
          "completion": "README summarized."
        }
      ]
    },
    {
      "name": "headless-resume-after-read-approval",
      "files": {
        "README.md": "fixture readme\n"
      },
      "sessions": [
        {
          "args": [
            "run",
            "Read README.md and summarize it.",
            "--allow-dir",
            ".",
            "--allow-remote-model-egress"
          ]
        },
        {
          "args": [
            "resume",
            "{run_id}",
            "--allow-dir",
            ".",
            "--allow-remote-model-egress",
            "--allow-read"
          ]
        }
      ],
      "replies": [
        {
          "plan": [
            "read",
            "xgeny.fs/read-text",
            {
              "path": "README.md"
            }
          ]
        },
        {
          "completion": "README summarized."
        }
      ],
      "description": "Headless Run pauses for read approval; resume in a new process rebuilds the planning context from the journal."
    },
    {
      "name": "interactive-reject-then-resume",
      "files": {
        "README.md": "fixture readme\n"
      },
      "args": [],
      "stdin": "Read README.md and report it.\ny\nn\n/resume\ny\ny\n/exit\n",
      "replies": [
        {
          "plan": [
            "read",
            "xgeny.fs/read-text",
            {
              "path": "README.md"
            }
          ]
        },
        {
          "completion": "README read after approval."
        }
