{
  "apiVersion": "xgeny.io/v1alpha1",
  "kind": "CapabilityDefinition",
  "metadata": {
    "id": "xgen.terminal/start",
    "contractVersion": "1.0.0",
    "displayName": "Terminal start",
    "labels": {
      "xgeny.io/pack": "core-os"
    }
  },
  "spec": {
    "summary": "Start a catalogued shell-free executable in a live PTY. Returns immediately with an opaque session handle. timeoutMs limits the session lifetime; maxOutputBytes bounds the output ring. Sessions end on host command exit and are never respawned during recovery.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "executable",
        "args",
        "cwd",
        "env",
        "timeoutMs",
        "maxOutputBytes"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 224,
          "pattern": "^(?:[a-z0-9][a-z0-9._+-]{0,127}|process:[a-z0-9][a-z0-9._-]{0,63}/executables/[a-z0-9][a-z0-9._+-]{0,127})$"
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "env": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32768
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "sessionId",
        "state",
        "exitCode",
        "output",
        "baseOffset",
        "nextOffset",
        "truncated",
        "acceptedBytes"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^pty-[0-9a-f]{64}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "stopping",
            "draining",
            "exited",
            "terminated",
            "timed_out",
            "launch_failed",
            "session_lost",
            "session_limit",
            "input_partial",
            "input_failed",
            "offset_invalid"
          ],
          "description": "running/stopping/draining are unsettled. exited/terminated/timed_out are settled only after PTY capture reaches EOF."
        },
        "exitCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          ]
        },
        "output": {
          "type": "string",
          "maxLength": 12288
        },
        "baseOffset": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte position immediately after the returned output. Empty snapshots from start/write/terminate use baseOffset; retain the cursor from the last read instead of advancing past unseen output."
        },
        "truncated": {
          "type": "boolean"
        },
        "acceptedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "class": "non_idempotent",
      "resourceSelectors": [
        {
          "scope": "process.execute",
          "argumentPointer": "/executable"
        }
      ],
      "criticalActions": []
    },
    "requiredCapabilities": [],
    "execution": {
      "styles": [
        "sync"
      ],
      "cancellable": false,
      "idempotencyKeySupported": true,
      "durableToolOutput": true,
      "defaultTimeoutMs": 2000,
      "maxTimeoutMs": 2000
    },
    "verification": [
      {
        "strategy": "output_schema",
        "required": true,
        "description": "Verify the bounded durable PTY observation without repeating input, spawning a command, or re-reading a live terminal."
      }
    ],
    "discovery": {
      "keywords": [
        "terminal",
        "pty",
        "session",
        "start"
      ],
      "examples": [
        "Start a catalogued shell-free executable in a live PTY. Returns immediately with an opaque session handle. timeoutMs limits the session lifetime; maxOutputBytes bounds the output ring. Sessions end on host command exit and are never respawned during recovery."
      ]
    }
  }
}
